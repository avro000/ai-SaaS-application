# Server Port & CORS Client URL
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexusai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth Client ID (matching frontend)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Model Inference Keys (Primary & Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: Pollinations Priority API Key (from enter.pollinations.ai)
POLLINATIONS_API_KEY=

# SMTP Email Configuration (Incident Reports & Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
ADMIN_EMAIL=your_email@gmail.com
